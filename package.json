{
  "name": "dsh-ima",
  "version": "0.5.0",
  "description": "让 DeepSeek Harness 读写腾讯 ima 知识库：左侧边栏「ima」填 API Key 即可搜索、读整篇文档、新建/追加笔记、上传文件与归档；共 16 个工具。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "ima",
    "tencent-ima",
    "ima.copilot",
    "knowledge-base",
    "tool"
  ],
  "license": "MIT",
  "icon": "./icon.svg",
  "author": "0131kikimy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0131kikimy/dsh-ima.git"
  },
  "homepage": "https://github.com/0131kikimy/dsh-ima#readme",
  "bugs": {
    "url": "https://github.com/0131kikimy/dsh-ima/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "os": [
    "win32",
    "darwin",
    "linux"
  ],
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "selfcheck": "node test/selfcheck.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
